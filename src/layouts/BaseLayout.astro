---
import '../styles/global.css';
import '../styles/landing.css';
import type { Locale } from '../i18n';
import { defaultLocale, getMessages } from '../i18n';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getMessages(locale);

const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://uhak-gps.netlify.app';
const enUrl = `${site}/`;
const jaUrl = `${site}/ja/`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={locale === 'ja' ? jaUrl : enUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shantell+Sans:wght@400;500&family=Outfit:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Murecho:wght@300;400;500;700&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Courier+Prime:wght@400&family=Klee+One:wght@400;600&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-surface font-sans text-ink antialiased">
    <slot />
  </body>
</html>
