---
import { ClientRouter } from 'astro:transitions';
import '../styles/zine.css';
import Masthead from '../components/zine/Masthead.astro';
import Footer from '../components/zine/Footer.astro';

interface Props {
  title: string;
  description: string;
  masthead?: 'cover' | 'compact';
  active?: 'home' | 'book';
}

const { title, description, masthead = 'compact', active = 'home' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#25D366" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Zilla+Slab:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Outfit:wght@400;500;600;700;800&family=Courier+Prime:wght@400;700&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
    />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body id="top">
    <div class="ed-progress" data-reading-progress aria-hidden="true">
      <div class="ed-progress-fill" data-reading-progress-fill></div>
    </div>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-primary focus:px-3 focus:py-2">Skip to content</a>
    <Masthead variant={masthead} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/zine-motion.ts';
    </script>
  </body>
</html>
