---
/** Instagram icon link — same account and glyph as the landing header. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<a
  href="https://www.instagram.com/gagopa_sydney"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="UHAK GPS on Instagram"
  class:list={['-mr-3 inline-flex size-9 items-center justify-center transition-colors', className]}
>
  <svg class="translate-y-px" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
  </svg>
</a>
