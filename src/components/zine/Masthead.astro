---
import Wordmark from './Wordmark.astro';

interface Props {
  variant?: 'cover' | 'compact';
}

const { variant = 'cover' } = Astro.props;

// Rendered on the server, then refreshed client-side by the clock in zine-motion.ts.
const sydDate = new Intl.DateTimeFormat('en-AU', {
  timeZone: 'Australia/Sydney',
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
---
<header class:list={['ed-masthead bg-surface text-ink', variant !== 'cover' && 'editorial-rule-bottom']}>
  <div class="wrap grid min-h-6 grid-cols-[1fr_auto] items-center gap-x-4 py-1.5">
    <p class:list={['ed-meta m-0 flex flex-wrap items-center gap-x-2 leading-none', variant === 'compact' && 'max-landing:hidden']}>
      <span>Sydney</span>
      <span class="text-muted" aria-hidden="true">·</span>
      <span class="syd-clock inline-flex items-baseline leading-none tabular-nums" data-syd-clock aria-label="Current time in Sydney">
        <span data-syd-h>00</span><span class="syd-colon" data-syd-colon>:</span><span data-syd-m>00</span>
        <span class="ml-1.5">SYD</span>
      </span>
      <span class="text-muted" aria-hidden="true">·</span>
      <span>Field notes</span>
    </p>

    {variant === 'compact' && (
      <Wordmark size="mobile" class="justify-self-center landing:hidden" />
    )}

    <div class="flex items-center justify-end gap-4 justify-self-end">
      <a href="/ja/" lang="ja" class="font-jp text-[13px] leading-none text-muted transition-colors hover:text-ink">日本語</a>
      <a href="/zine/book/" class="ed-btn min-h-9! px-4! text-[11px]!">Book a chat</a>
    </div>
  </div>

  {variant === 'cover' ? (
    <div class="wrap">
      <div class="ed-masthead-broadsheet">
        <div class="ed-masthead-brand">
          <p class="ed-masthead-ear ed-masthead-ear--left m-0">
            <span class="ed-masthead-ear-kicker">Est. Sydney</span>
            “Talk before you decide.”
          </p>
          <Wordmark size="broadsheet" />
          <a href="/zine/book/" class="ed-masthead-ear ed-masthead-ear--right">
            <span class="ed-masthead-ear-kicker">Free · 20 min</span>
            Book a chat with a local →
          </a>
        </div>
        <p class="ed-masthead-dateline ed-meta m-0">
          <span>Vol. 01 · No. 07</span>
          <span class="ed-masthead-date" data-syd-date>{sydDate}</span>
          <span class="max-landing:hidden">Sydney edition · Free</span>
        </p>
      </div>
    </div>
  ) : (
    <div class="wrap hidden items-end justify-between gap-6 border-t border-ink py-2.5 landing:flex">
      <Wordmark size="compact" />
      <p class="ed-meta m-0 text-muted">Vol. 01 · Nov 2026</p>
    </div>
  )}
</header>
