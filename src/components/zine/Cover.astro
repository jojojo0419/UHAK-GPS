---
import type { CoverVariant } from '../../zine/content';

interface Props {
  cover: CoverVariant;
  class?: string;
  /** Hide inner labels on tiny thumbnails. */
  small?: boolean;
  eager?: boolean;
}

const { cover, class: className = '', small = false, eager = false } = Astro.props;
const face = 'Zilla Slab, serif';
---
<div class:list={['ed-crop relative', className]}>
  {cover.kind === 'photo' && (
    <div class:list={['absolute inset-0', 'duo', cover.tone]}>
      <img
        src={cover.src}
        alt={cover.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-cover"
        style={cover.position ? `object-position:${cover.position}` : undefined}
      />
    </div>
  )}

  {cover.kind === 'ticket' && (
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="400" height="300" fill="#CFE4FB" />
      <g stroke="#111315" stroke-width="2" fill="none" stroke-linecap="round">
        <path d="M300 74a26 26 0 0 1 26 26" />
        <path d="M300 58a42 42 0 0 1 42 42" />
        <path d="M300 42a58 58 0 0 1 58 58" />
      </g>
      <g transform="rotate(-8 200 160)">
        <rect x="92" y="92" width="216" height="136" rx="10" fill="#111315" />
        <rect x="110" y="140" width="42" height="30" rx="5" fill="#F6E3A8" />
        <path d="M124 140v30M138 140v30M110 155h42" stroke="#111315" stroke-width="1.5" />
        <circle cx="272" cy="124" r="18" fill="#25D366" />
        {!small && (
          <>
            <text x="110" y="122" font-family={face} font-size="14" font-weight="700" fill="#fff" letter-spacing="2">ADULT</text>
            <text x="110" y="208" font-family={face} font-size="10" fill="#fff" opacity=".75" letter-spacing="1">TAP ON · TAP OFF · WEEKLY CAP</text>
          </>
        )}
      </g>
    </svg>
  )}

  {cover.kind === 'receipt' && (
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="400" height="300" fill="#F6E3A8" />
      <circle cx="70" cy="240" r="60" fill="#25D366" />
      <g transform="rotate(4 200 150)">
        <path
          d="M128 18h144v262l-12 -10 -12 10 -12 -10 -12 10 -12 -10 -12 10 -12 -10 -12 10 -12 -10 -12 10 -12 -10 -12 10z"
          fill="#fff"
          stroke="#111315"
          stroke-width="1.5"
        />
        {small ? (
          <g stroke="#111315" stroke-width="3">
            <path d="M148 70h104M148 100h80M148 130h104M148 160h64M148 200h104" />
          </g>
        ) : (
          <g font-family={face} font-size="12" fill="#111315">
            <text x="200" y="48" text-anchor="middle" font-weight="700" letter-spacing="2">ONE WEEK</text>
            <text x="200" y="64" text-anchor="middle" font-size="9" opacity=".6">SYDNEY · SHARE HOUSE</text>
            <path d="M144 76h112" stroke="#111315" stroke-dasharray="3 3" />
            <text x="144" y="98">ROOM</text><text x="256" y="98" text-anchor="end">340</text>
            <text x="144" y="118">TRANSPORT</text><text x="256" y="118" text-anchor="end">50</text>
            <text x="144" y="138">FOOD</text><text x="256" y="138" text-anchor="end">105</text>
            <text x="144" y="158">PHONE</text><text x="256" y="158" text-anchor="end">10</text>
            <text x="144" y="178">COFFEE ×5</text><text x="256" y="178" text-anchor="end">29</text>
            <path d="M144 192h112" stroke="#111315" stroke-dasharray="3 3" />
            <text x="144" y="214" font-weight="700">TOTAL</text><text x="256" y="214" text-anchor="end" font-weight="700">~564</text>
          </g>
        )}
      </g>
    </svg>
  )}

  {cover.kind === 'stamp' && (
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="400" height="300" fill="#E7F8E2" />
      <g stroke="#111315" stroke-width="1" opacity=".18">
        {Array.from({ length: 14 }, (_, i) => <path d={`M0 ${22 + i * 20}h400`} />)}
      </g>
      <rect x="236" y="36" width="120" height="78" fill="#25D366" transform="rotate(6 296 75)" />
      <g transform="rotate(-12 180 160)">
        <circle cx="180" cy="160" r="94" fill="none" stroke="#111315" stroke-width="4" />
        <circle cx="180" cy="160" r="80" fill="none" stroke="#111315" stroke-width="1.5" />
        {!small && (
          <>
            <text x="180" y="124" text-anchor="middle" font-family={face} font-size="14" font-weight="700" fill="#111315" letter-spacing="3">417 · 500</text>
            <text x="180" y="184" text-anchor="middle" font-family={face} font-size="58" font-weight="600" fill="#111315">Visa?</text>
            <text x="180" y="212" text-anchor="middle" font-family={face} font-size="11" fill="#111315" letter-spacing="2">WORK · STUDY · BOTH</text>
          </>
        )}
        {small && <path d="M130 160h100M150 130h60M150 190h60" stroke="#111315" stroke-width="6" />}
      </g>
    </svg>
  )}

  {cover.kind === 'map' && (
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="400" height="300" fill="#F3F2EE" />
      <g stroke="#111315" stroke-width="1.5" fill="none">
        <path d="M-10 70 L410 40" /><path d="M-10 150 L410 120" /><path d="M-10 230 L410 205" />
        <path d="M80 -10 L120 310" /><path d="M190 -10 L215 310" /><path d="M300 -10 L320 310" />
        <path d="M-10 290 C120 250 260 290 410 250" stroke-width="3" />
      </g>
      <rect x="222" y="128" width="78" height="70" fill="#25D366" transform="rotate(-4 261 163)" />
      <path d="M140 102 C170 120 200 140 236 150" stroke="#008069" stroke-width="3" stroke-dasharray="2 7" stroke-linecap="round" fill="none" />
      <circle cx="140" cy="100" r="14" fill="none" stroke="#111315" stroke-width="2" />
      <circle cx="140" cy="100" r="6" fill="#111315" />
      {!small && (
        <g font-family={face} font-size="11" fill="#111315" letter-spacing="1">
          <text x="64" y="84">TOWN HALL</text>
          <text x="232" y="216">HYDE PARK</text>
          <text x="20" y="276" opacity=".6">8 MIN WALK</text>
        </g>
      )}
    </svg>
  )}

  {cover.kind === 'type' && (
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="400" height="300" fill="#25D366" />
      <circle cx="320" cy="64" r="34" fill="none" stroke="#111315" stroke-width="2" />
      <text x="200" y="250" text-anchor="middle" font-family={face} font-size="300" font-weight="600" fill="#111315">?</text>
    </svg>
  )}

  {cover.kind === 'shapes' && (
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="400" height="300" fill="#008069" />
      <path d="M40 300 A120 120 0 0 1 280 300 Z" fill="#25D366" />
      <rect x="250" y="40" width="96" height="96" fill="#111315" transform="rotate(12 298 88)" />
      <rect x="0" y="150" width="400" height="16" fill="#fff" />
      <circle cx="112" cy="84" r="22" fill="#E7F8E2" />
      {!small && (
        <g font-family={face} font-size="11" fill="#fff" letter-spacing="2">
          <text x="22" y="30">TAFE / COLLEGE / UNI</text>
        </g>
      )}
    </svg>
  )}
</div>
